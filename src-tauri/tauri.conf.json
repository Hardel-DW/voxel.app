{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "studio",
    "version": "0.1.0",
    "identifier": "com.hardel-dw.studio",
    "plugins": {
        "cli": {
            "args": [
                {
                    "name": "launch_by_minecraft",
                    "short": "m",
                    "takesValue": true,
                    "description": "Path to mods/datapack folder when launched from Minecraft"
                }
            ]
        }
    },
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Voxel Studio Pro",
                "width": 1280,
                "height": 800,
                "decorations": false,
                "transparent": true
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}